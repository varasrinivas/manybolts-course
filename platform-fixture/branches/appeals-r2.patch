+package com.meridiancare.priorauth.appeals;
+
+import java.time.LocalDate;
+
+/**
+ * Reminds the appeals queue three days before a statutory deadline.
+ *
+ * <p>Retries use the retry toolkit rather than a hand-rolled loop.
+ */
+public class AppealDeadlineNotifier {
+
+    public boolean notifyIfDue(String appealRef, LocalDate deadline, LocalDate today) {
+        if (appealRef == null || deadline == null) {
+            throw new AppealException("MISSING_INPUT", "appealRef and deadline are required");
+        }
+        return !today.isBefore(deadline.minusDays(3));
+    }
+}
