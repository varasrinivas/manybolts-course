+package com.meridiancare.priorauth.appeals;
+
+import com.meridiancare.priorauth.annotation.PhiBoundary;
+import com.meridiancare.priorauth.domain.AuthStatus;
+
+/** POST /determinations/{id}/appeal */
+public class AppealController {
+
+    private final AppealReviewService reviewService;
+
+    public AppealController(AppealReviewService reviewService) {
+        this.reviewService = reviewService;
+    }
+
+    @PhiBoundary(reason = "appeal carries the member record")
+    public AuthStatus lodge(String requestId, String memberId) {
+        if (requestId == null || memberId == null) {
+            throw new AppealException("MISSING_INPUT", "requestId and memberId are required");
+        }
+        return AuthStatus.APPEALED;
+    }
+}
